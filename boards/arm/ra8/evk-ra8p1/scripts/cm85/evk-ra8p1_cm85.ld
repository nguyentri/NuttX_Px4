/****************************************************************************
 * boards/arm/ra8/evk-ra8p1/scripts/cm85/evk-ra8p1_cm85.ld
 *
 * Modular Linker Script for Cortex-M85 (CPU0) on Renesas RA8P1
 * Preserves all Renesas FSP symbols required by ra_start.c
 ****************************************************************************/

/* Memory region base addresses */
FLASH_START = 0x02000000;
FLASH_LENGTH = 0x00080000;
RAM_START = 0x22000000;
RAM_LENGTH = 0x000D0000;
ITCM_START = 0x00000000;
ITCM_LENGTH = 0x00020000;
DTCM_START = 0x20000000;
DTCM_LENGTH = 0x00020000;
OSPI0_CS0_START = 0x80000000;
OSPI0_CS0_LENGTH = 0x04000000;
IPC_SHMEM_START = 0x220D0000;
IPC_SHMEM_LENGTH = 0x00010000;
SDRAM_START = 0x68000000;
SDRAM_LENGTH = 0x08000000;
OSPI0_CS1_START = 0x90000000;
OSPI0_CS1_LENGTH = 0x04000000;
OSPI1_CS0_START = 0x70000000;
OSPI1_CS0_LENGTH = 0x08000000;
OSPI1_CS1_START = 0xA0000000;
OSPI1_CS1_LENGTH = 0x04000000;
DATA_FLASH_START = 0x08000000;
DATA_FLASH_LENGTH = 0x00010000;
FLASH_APP_START = OSPI0_CS0_START;
FLASH_APP_LENGTH = OSPI0_CS0_LENGTH;

/* Option setting registers */
OPTION_SETTING_OFS0_START = 0x0100A100;
OPTION_SETTING_OFS0_LENGTH = 0x4;
OPTION_SETTING_OFS1_START = 0x0100A104;
OPTION_SETTING_OFS1_LENGTH = 0x4;
OPTION_SETTING_OFS2_START = 0x0100A108;
OPTION_SETTING_OFS2_LENGTH = 0x4;
OPTION_SETTING_OFS3_START = 0x0100A10C;
OPTION_SETTING_OFS3_LENGTH = 0x4;
OPTION_SETTING_OFS0_SEC_START = 0x0100A110;
OPTION_SETTING_OFS0_SEC_LENGTH = 0x4;
OPTION_SETTING_OFS1_SEC_START = 0x0100A114;
OPTION_SETTING_OFS1_SEC_LENGTH = 0x4;
OPTION_SETTING_OFS2_SEC_START = 0x0100A118;
OPTION_SETTING_OFS2_SEC_LENGTH = 0x4;
OPTION_SETTING_OFS3_SEC_START = 0x0100A11C;
OPTION_SETTING_OFS3_SEC_LENGTH = 0x4;
OPTION_SETTING_OFS3_SEL_START = 0x0100A120;
OPTION_SETTING_OFS3_SEL_LENGTH = 0x4;
OPTION_SETTING_BPS_START = 0x0100A138;
OPTION_SETTING_BPS_LENGTH = 0x100;
OPTION_SETTING_BPS_SEC_START = 0x0100A238;
OPTION_SETTING_BPS_SEC_LENGTH = 0x100;
OPTION_SETTING_OTP_FSBLCTRL0_START = 0x01002200;
OPTION_SETTING_OTP_FSBLCTRL0_LENGTH = 0x4;
OPTION_SETTING_OTP_FSBLCTRL1_START = 0x01002204;
OPTION_SETTING_OTP_FSBLCTRL1_LENGTH = 0x4;
OPTION_SETTING_OTP_FSBLCTRL2_START = 0x01002208;
OPTION_SETTING_OTP_FSBLCTRL2_LENGTH = 0x4;
OPTION_SETTING_OTP_SAMR_START = 0x0100220C;
OPTION_SETTING_OTP_SAMR_LENGTH = 0x4;
OPTION_SETTING_OTP_SACC00_START = 0x01002210;
OPTION_SETTING_OTP_SACC00_LENGTH = 0x4;
OPTION_SETTING_OTP_SACC10_START = 0x01002214;
OPTION_SETTING_OTP_SACC10_LENGTH = 0x4;
OPTION_SETTING_OTP_SACC01_START = 0x01002218;
OPTION_SETTING_OTP_SACC01_LENGTH = 0x4;
OPTION_SETTING_OTP_SACC11_START = 0x0100221C;
OPTION_SETTING_OTP_SACC11_LENGTH = 0x4;
OPTION_SETTING_OTP_SACC02_START = 0x01002220;
OPTION_SETTING_OTP_SACC02_LENGTH = 0x4;
OPTION_SETTING_OTP_SACC12_START = 0x01002224;
OPTION_SETTING_OTP_SACC12_LENGTH = 0x4;
OPTION_SETTING_OTP_SACC03_START = 0x01002228;
OPTION_SETTING_OTP_SACC03_LENGTH = 0x4;
OPTION_SETTING_OTP_SACC13_START = 0x0100222C;
OPTION_SETTING_OTP_SACC13_LENGTH = 0x4;
OPTION_SETTING_OTP_PBPS_SEC_START = 0x01002230;
OPTION_SETTING_OTP_PBPS_SEC_LENGTH = 0x100;
OPTION_SETTING_OTP_PBPS_START = 0x01002330;
OPTION_SETTING_OTP_PBPS_LENGTH = 0x100;
OPTION_SETTING_OTP_ZHUK_START = 0x01002430;
OPTION_SETTING_OTP_ZHUK_LENGTH = 0x10;

MEMORY
{
    FLASH (rx) : ORIGIN = FLASH_START, LENGTH = FLASH_LENGTH
    RAM (rwx) : ORIGIN = RAM_START, LENGTH = RAM_LENGTH
    ITCM (rwx) : ORIGIN = ITCM_START, LENGTH = ITCM_LENGTH
    DTCM (rwx) : ORIGIN = DTCM_START, LENGTH = DTCM_LENGTH
    FLASH_APP (rx) : ORIGIN = FLASH_APP_START, LENGTH = FLASH_APP_LENGTH
    SDRAM (rwx) : ORIGIN = SDRAM_START, LENGTH = SDRAM_LENGTH
    OSPI0_CS0 (rx) : ORIGIN = OSPI0_CS0_START, LENGTH = OSPI0_CS0_LENGTH
    OSPI0_CS1 (rx) : ORIGIN = OSPI0_CS1_START, LENGTH = OSPI0_CS1_LENGTH
    OSPI1_CS0 (rx) : ORIGIN = OSPI1_CS0_START, LENGTH = OSPI1_CS0_LENGTH
    OSPI1_CS1 (rx) : ORIGIN = OSPI1_CS1_START, LENGTH = OSPI1_CS1_LENGTH
    DATA_FLASH (r) : ORIGIN = DATA_FLASH_START, LENGTH = DATA_FLASH_LENGTH
    IPC_SHMEM_REGION (rw) : ORIGIN = IPC_SHMEM_START, LENGTH = IPC_SHMEM_LENGTH
    OPTION_SETTING_OFS0 (r) : ORIGIN = OPTION_SETTING_OFS0_START, LENGTH = OPTION_SETTING_OFS0_LENGTH
    OPTION_SETTING_OFS1 (r) : ORIGIN = OPTION_SETTING_OFS1_START, LENGTH = OPTION_SETTING_OFS1_LENGTH
    OPTION_SETTING_OFS2 (r) : ORIGIN = OPTION_SETTING_OFS2_START, LENGTH = OPTION_SETTING_OFS2_LENGTH
    OPTION_SETTING_OFS3 (r) : ORIGIN = OPTION_SETTING_OFS3_START, LENGTH = OPTION_SETTING_OFS3_LENGTH
    OPTION_SETTING_OFS0_SEC (r) : ORIGIN = OPTION_SETTING_OFS0_SEC_START, LENGTH = OPTION_SETTING_OFS0_SEC_LENGTH
    OPTION_SETTING_OFS1_SEC (r) : ORIGIN = OPTION_SETTING_OFS1_SEC_START, LENGTH = OPTION_SETTING_OFS1_SEC_LENGTH
    OPTION_SETTING_OFS2_SEC (r) : ORIGIN = OPTION_SETTING_OFS2_SEC_START, LENGTH = OPTION_SETTING_OFS2_SEC_LENGTH
    OPTION_SETTING_OFS3_SEC (r) : ORIGIN = OPTION_SETTING_OFS3_SEC_START, LENGTH = OPTION_SETTING_OFS3_SEC_LENGTH
    OPTION_SETTING_OFS3_SEL (r) : ORIGIN = OPTION_SETTING_OFS3_SEL_START, LENGTH = OPTION_SETTING_OFS3_SEL_LENGTH
    OPTION_SETTING_BPS (r) : ORIGIN = OPTION_SETTING_BPS_START, LENGTH = OPTION_SETTING_BPS_LENGTH
    OPTION_SETTING_BPS_SEC (r) : ORIGIN = OPTION_SETTING_BPS_SEC_START, LENGTH = OPTION_SETTING_BPS_SEC_LENGTH
    OPTION_SETTING_OTP_FSBLCTRL0 (r) : ORIGIN = OPTION_SETTING_OTP_FSBLCTRL0_START, LENGTH = OPTION_SETTING_OTP_FSBLCTRL0_LENGTH
    OPTION_SETTING_OTP_FSBLCTRL1 (r) : ORIGIN = OPTION_SETTING_OTP_FSBLCTRL1_START, LENGTH = OPTION_SETTING_OTP_FSBLCTRL1_LENGTH
    OPTION_SETTING_OTP_FSBLCTRL2 (r) : ORIGIN = OPTION_SETTING_OTP_FSBLCTRL2_START, LENGTH = OPTION_SETTING_OTP_FSBLCTRL2_LENGTH
    OPTION_SETTING_OTP_SAMR (r) : ORIGIN = OPTION_SETTING_OTP_SAMR_START, LENGTH = OPTION_SETTING_OTP_SAMR_LENGTH
    OPTION_SETTING_OTP_SACC00 (r) : ORIGIN = OPTION_SETTING_OTP_SACC00_START, LENGTH = OPTION_SETTING_OTP_SACC00_LENGTH
    OPTION_SETTING_OTP_SACC10 (r) : ORIGIN = OPTION_SETTING_OTP_SACC10_START, LENGTH = OPTION_SETTING_OTP_SACC10_LENGTH
    OPTION_SETTING_OTP_SACC01 (r) : ORIGIN = OPTION_SETTING_OTP_SACC01_START, LENGTH = OPTION_SETTING_OTP_SACC01_LENGTH
    OPTION_SETTING_OTP_SACC11 (r) : ORIGIN = OPTION_SETTING_OTP_SACC11_START, LENGTH = OPTION_SETTING_OTP_SACC11_LENGTH
    OPTION_SETTING_OTP_SACC02 (r) : ORIGIN = OPTION_SETTING_OTP_SACC02_START, LENGTH = OPTION_SETTING_OTP_SACC02_LENGTH
    OPTION_SETTING_OTP_SACC12 (r) : ORIGIN = OPTION_SETTING_OTP_SACC12_START, LENGTH = OPTION_SETTING_OTP_SACC12_LENGTH
    OPTION_SETTING_OTP_SACC03 (r) : ORIGIN = OPTION_SETTING_OTP_SACC03_START, LENGTH = OPTION_SETTING_OTP_SACC03_LENGTH
    OPTION_SETTING_OTP_SACC13 (r) : ORIGIN = OPTION_SETTING_OTP_SACC13_START, LENGTH = OPTION_SETTING_OTP_SACC13_LENGTH
    OPTION_SETTING_OTP_PBPS_SEC (r) : ORIGIN = OPTION_SETTING_OTP_PBPS_SEC_START, LENGTH = OPTION_SETTING_OTP_PBPS_SEC_LENGTH
    OPTION_SETTING_OTP_PBPS (r) : ORIGIN = OPTION_SETTING_OTP_PBPS_START, LENGTH = OPTION_SETTING_OTP_PBPS_LENGTH
    OPTION_SETTING_OTP_ZHUK (r) : ORIGIN = OPTION_SETTING_OTP_ZHUK_START, LENGTH = OPTION_SETTING_OTP_ZHUK_LENGTH
}

OUTPUT_ARCH(arm)
EXTERN(_vectors)
ENTRY(_stext)

INCLUDE ../common/renesas_option_settings.ld
INCLUDE ../common/renesas_copy_sections.ld
INCLUDE ../common/renesas_zero_sections.ld
INCLUDE cm85_kernel_sections.ld
INCLUDE cm85_px4_app_sections.ld
INCLUDE cm85_ipc_sections.ld

PROVIDE( _sdata = ADDR(__ram_from_flash$$) );
PROVIDE( _edata = ADDR(__ram_from_flash$$) + SIZEOF(__ram_from_flash$$) );
PROVIDE( _stext = ADDR(__flash_readonly$$));
PROVIDE( _etext = ADDR(__flash_readonly$$) + SIZEOF(__flash_readonly$$) );
PROVIDE( _eronly = ADDR(__flash_readonly$$) + SIZEOF(__flash_readonly$$) );
PROVIDE( _sbss = ADDR(__ram_zero$$) );
PROVIDE( _ebss = ADDR(__ram_zero$$) + SIZEOF(__ram_zero$$) );
