#
# RDK-RZ/V2H ipcc-multi defconfig
#
# All three inter-core links enabled on CR8_0:
#   /dev/ipcc0  — CA55↔CR8 via rptun/OpenAMP  (unchanged from :ipcc)
#   /dev/ipcc1  — CR8_0↔CR8_1 raw MHU+SHM    (initiator side)
#   /dev/ipcc2  — CR8_0↔CM33  raw MHU+SHM    (initiator side)
#   /dev/ipccLB — CR8_0 self-loopback         (smoke-test without CR8_1)
#
# Do NOT hand-edit — regenerate with "make savedefconfig" after menuconfig.
#
CONFIG_ARCH="arm"
CONFIG_ARCH_BOARD="rdk-rzv2h"
CONFIG_ARCH_BOARD_RDK_RZV2H=y
CONFIG_ARCH_CHIP="rzv"
CONFIG_ARCH_CHIP_RZV=y
CONFIG_ARCH_CHIP_R9A09G057=y
CONFIG_ARMV7R_TOOLCHAIN_GNU_EABI=y
CONFIG_ARCH_STACKDUMP=y
CONFIG_ARMV7R_DCACHE=y
CONFIG_ARMV7R_DTCM=y
CONFIG_ARMV7R_ICACHE=y
CONFIG_ARMV7R_ITCM=y
CONFIG_BINFMT_DISABLE=y
CONFIG_BOARD_LOOPSPERMSEC=200000
CONFIG_BUILTIN=y
CONFIG_FS_PROCFS=y
CONFIG_IDLETHREAD_STACKSIZE=2048
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_INTELHEX_BINARY=y
CONFIG_LIBC_LOCALTIME=y
CONFIG_LINE_MAX=64
CONFIG_BOARDCTL=y
CONFIG_BOARD_LATE_INITIALIZE=y
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_DISABLE_IFUPDOWN=y
CONFIG_NSH_FILEIOSIZE=512
CONFIG_NSH_READLINE=y
CONFIG_RZV_DTCM=16
CONFIG_RZV_ITCM=16
CONFIG_RAM_SIZE=524288
CONFIG_RAM_START=0x22060000
CONFIG_RAW_BINARY=y
CONFIG_SCHED_BACKTRACE=y
CONFIG_START_DAY=10
CONFIG_START_MONTH=9
CONFIG_START_YEAR=2025
CONFIG_SYSTEM_NSH=y
CONFIG_SYSTEM_NSH_PRIORITY=100
CONFIG_SYSTEM_NSH_STACKSIZE=2048
CONFIG_USEC_PER_TICK=1000
CONFIG_SPINLOCK=y

# NSH Library - Use SCI1 for command interface
CONFIG_NSH_LIBRARY=y
CONFIG_NSH_CONSOLE=y
CONFIG_NSH_UARTDEV="/dev/ttyS0"
CONFIG_NSH_CONDEV="/dev/ttyS0"

# Core Specific Configuration
CONFIG_RZV2H_BUILD_CR8_0=y

# Clocking Configuration
CONFIG_RZV_CLOCK_PLL=y

# Serial Configuration (SCI1 for NSH console)
CONFIG_SERIAL=y
CONFIG_STANDARD_SERIAL=y
CONFIG_SCI1_SERIALDRIVER=y
CONFIG_SCI1_SERIAL_CONSOLE=y
CONFIG_SCI1_RXBUFSIZE=256
CONFIG_SCI1_TXBUFSIZE=256
CONFIG_SCI1_BAUD=115200
CONFIG_SCI1_BITS=8
CONFIG_SCI1_PARITY=0
CONFIG_SCI1_2STOP=0
CONFIG_RZV_SCI1=y

# Console support (SCI1 will be console)
CONFIG_DEV_CONSOLE=y
CONFIG_SERIAL_CONSOLE=y

# ---- Tier 2: CA55↔CR8 rptun/OpenAMP (unchanged from :ipcc) ----
CONFIG_EXPERIMENTAL=y
CONFIG_OPENAMP=y
CONFIG_RPTUN=y
CONFIG_RPTUN_THREAD=y
CONFIG_RZV_OPENAMP=y
CONFIG_DEV_SIMPLE_ADDRENV=y
CONFIG_RZV_IPC_IPCC=y
CONFIG_IPCC=y
CONFIG_IPCC_BUFFERED=y
CONFIG_IPCC_NPOLLWAITERS=4

# ---- Tier 1: Raw MHU+SHM IPCC links ----
CONFIG_RZV_IPC_RAW=y
CONFIG_RZV_IPC_TX_TIMEOUT_MS=100

# /dev/ipcc1 — CR8_0↔CR8_1 (this side is initiator)
# MHU0 NS ch4 (TX, RSP-ACK IRQ=327) / ch9 (RX, MSG IRQ=316)
CONFIG_RZV_IPC_CR8_CR8=y
CONFIG_RZV_IPC_ROLE_INITIATOR=y

# /dev/ipccLB — CR8_0 self-loopback smoke test
# MHU0 NS ch16 (combined MSG IRQ=319 / RSP IRQ=331)
CONFIG_RZV_IPC_CR8_CR8_LOOPBACK=y

# /dev/ipcc2 — CR8_0↔CM33 (CR8 side; CM33 firmware out-of-tree)
# MHU0 NS ch10 (TX, RSP-ACK IRQ=329) / ch15 (RX, MSG IRQ=318)
CONFIG_RZV_IPC_CR8_CM33=y

# ---- MPU port (FreeRTOS FSP region table) ----
# Region 9 (16 MiB @ 0x43000000, NC-Shareable) covers IPC raw SHM at 0x43800000
CONFIG_RZV_MPU_PORT_FSP=y
CONFIG_RZV_MPU_CR8_CORE_NUM=0

# ---- Sample app ----
CONFIG_EXAMPLES_RZV_IPC_DEMO=y

# Debug features
CONFIG_DEBUG_ALERT=y
CONFIG_DEBUG_ERROR=y
CONFIG_DEBUG_WARN=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_FULLOPT=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_DEBUG_SYMBOLS_LEVEL="-g3"
CONFIG_DEBUG_OPTLEVEL="-O0"

# RTT Configuration (disabled for minimal build)
# CONFIG_SERIAL_RTT_CONSOLE is not set
# CONFIG_SERIAL_RTT0 is not set
# CONFIG_SYSLOG_RTT is not set
# CONFIG_SYSLOG_CONSOLE is not set
# CONFIG_CONSOLE_SYSLOG is not set
# CONFIG_SEGGER_SYSVIEW is not set
# CONFIG_SEGGER_RTT is not set

# FPU Configuration
CONFIG_ARCH_FPU=y
CONFIG_ARCH_DPFPU=y

# Enable idle state logging
# CONFIG_ARCH_IDLE_CUSTOM is not set
# CONFIG_RZV_IDLE_LOG_STATE is not set
