#
# HWTEST SPI loopback — MOSI<->MISO (Pin 19<->21). MPU9250 removed.
#
CONFIG_ARCH="arm"
CONFIG_ARCH_BOARD="rdk-rzv2h"
CONFIG_ARCH_BOARD_RDK_RZV2H=y
CONFIG_ARCH_CHIP="rzv"
CONFIG_ARCH_CHIP_RZV=y
CONFIG_ARCH_CHIP_R9A09G057=y
CONFIG_ARMV7R_TOOLCHAIN_GNU_EABI=y
CONFIG_ARCH_STACKDUMP=y
CONFIG_ARMV7R_DCACHE=y
CONFIG_ARMV7R_DTCM=y
CONFIG_ARMV7R_ICACHE=y
CONFIG_ARMV7R_ITCM=y
CONFIG_BINFMT_DISABLE=y
CONFIG_BOARD_LOOPSPERMSEC=200000
CONFIG_BUILTIN=y
CONFIG_FS_PROCFS=n
CONFIG_IDLETHREAD_STACKSIZE=2048
CONFIG_INIT_ENTRYPOINT="hwtest_main"
CONFIG_INTELHEX_BINARY=y
CONFIG_LIBC_LOCALTIME=y
CONFIG_LINE_MAX=128
CONFIG_RZV_DTCM=16
CONFIG_RZV_ITCM=16
CONFIG_RAM_SIZE=524288
CONFIG_RAM_START=0x22060000
CONFIG_RAW_BINARY=y
CONFIG_SCHED_BACKTRACE=y
CONFIG_START_DAY=16
CONFIG_START_MONTH=5
CONFIG_START_YEAR=2026
CONFIG_USEC_PER_TICK=1000
CONFIG_SPINLOCK=y

# Clock
CONFIG_RZV_CLOCK_PLL=y

# RTT-only console
CONFIG_DEV_CONSOLE=y
# CONFIG_SERIAL_CONSOLE is not set
CONFIG_SERIAL_RTT0=y
CONFIG_SERIAL_RTT_CONSOLE=y
CONFIG_SYSLOG_RTT=y
CONFIG_SEGGER_RTT=y
CONFIG_SEGGER_RTT_BUFFER_SIZE_UP=4096
CONFIG_SEGGER_RTT_BUFFER_SIZE_DOWN=1024
CONFIG_SEGGER_RTT_PRINTF_BUFFER_SIZE=1024

# SPI
CONFIG_SPI=y
CONFIG_SPI_DRIVER=y
CONFIG_SPI_EXCHANGE=y
CONFIG_SPI_CMDDATA=y
CONFIG_RZV_SPI=y
CONFIG_RZV_SPI0=y

# Debug
CONFIG_DEBUG_ALERT=y
CONFIG_DEBUG_ERROR=y
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_FULLOPT=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_DEBUG_SYMBOLS_LEVEL="-g3"
CONFIG_DEBUG_OPTLEVEL="-O0"

# HWTEST app
CONFIG_TESTING_RZV_HWTEST=y
CONFIG_TESTING_RZV_HWTEST_MODE_SPI_LOOPBACK=y
CONFIG_TESTING_RZV_HWTEST_PROGNAME="hwtest"
CONFIG_TESTING_RZV_HWTEST_PRIORITY=100
CONFIG_TESTING_RZV_HWTEST_STACKSIZE=8192
