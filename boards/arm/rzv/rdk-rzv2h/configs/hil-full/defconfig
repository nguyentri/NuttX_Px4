#
# HWTEST HIL full — real PX4 drone sensors per RDK-RZ/V2H pinout.
# MPU9250 (SPI Pin19/21/23/24), BMP280 (I2C7 Pin3/5), GPS-M10 (UART9),
# TFmini (UART4), Sik (UART5 optional).
#
CONFIG_ARCH="arm"
CONFIG_ARCH_BOARD="rdk-rzv2h"
CONFIG_ARCH_BOARD_RDK_RZV2H=y
CONFIG_ARCH_CHIP="rzv"
CONFIG_ARCH_CHIP_RZV=y
CONFIG_ARCH_CHIP_R9A09G057=y
CONFIG_ARMV7R_TOOLCHAIN_GNU_EABI=y
CONFIG_ARCH_STACKDUMP=y
CONFIG_ARMV7R_DCACHE=y
CONFIG_ARMV7R_DTCM=y
CONFIG_ARMV7R_ICACHE=y
CONFIG_ARMV7R_ITCM=y
CONFIG_BINFMT_DISABLE=y
CONFIG_BOARD_LOOPSPERMSEC=200000
CONFIG_BUILTIN=y
CONFIG_FS_PROCFS=n
CONFIG_IDLETHREAD_STACKSIZE=2048
CONFIG_INIT_ENTRYPOINT="hwtest_main"
CONFIG_INTELHEX_BINARY=y
CONFIG_LIBC_LOCALTIME=y
CONFIG_LINE_MAX=128
CONFIG_RZV_DTCM=16
CONFIG_RZV_ITCM=16
CONFIG_RAM_SIZE=524288
CONFIG_RAM_START=0x22060000
CONFIG_RAW_BINARY=y
CONFIG_SCHED_BACKTRACE=y
CONFIG_START_DAY=16
CONFIG_START_MONTH=5
CONFIG_START_YEAR=2026
CONFIG_USEC_PER_TICK=1000
CONFIG_SPINLOCK=y

# Clock
CONFIG_RZV_CLOCK_PLL=y

# RTT-only console
CONFIG_DEV_CONSOLE=y
# CONFIG_SERIAL_CONSOLE is not set
CONFIG_SERIAL_RTT0=y
CONFIG_SERIAL_RTT_CONSOLE=y
CONFIG_SYSLOG_RTT=y
CONFIG_SEGGER_RTT=y
CONFIG_SEGGER_RTT_BUFFER_SIZE_UP=4096
CONFIG_SEGGER_RTT_BUFFER_SIZE_DOWN=1024
CONFIG_SEGGER_RTT_PRINTF_BUFFER_SIZE=1024

# SPI for MPU9250
CONFIG_SPI=y
CONFIG_SPI_DRIVER=y
CONFIG_SPI_EXCHANGE=y
CONFIG_SPI_CMDDATA=y
CONFIG_RZV_SPI=y
CONFIG_RZV_SPI0=y

# I2C7 (SCI-I2C on P76/P77) for BMP280
CONFIG_I2C=y
CONFIG_I2C_DRIVER=y
CONFIG_RZV_SCI_I2C=y
CONFIG_RZV_SCI_I2C7=y

# UART4 (TFmini), UART5 (Sik), UART9 (GPS)
CONFIG_SERIAL=y
CONFIG_STANDARD_SERIAL=y
CONFIG_SERIAL_TERMIOS=y

CONFIG_RZV_SCI4=y
CONFIG_SCI4_SERIALDRIVER=y
CONFIG_SCI4_BAUD=115200
CONFIG_SCI4_BITS=8
CONFIG_SCI4_PARITY=0
CONFIG_SCI4_2STOP=0
CONFIG_SCI4_RXBUFSIZE=512
CONFIG_SCI4_TXBUFSIZE=512

CONFIG_RZV_SCI5=y
CONFIG_SCI5_SERIALDRIVER=y
CONFIG_SCI5_BAUD=57600
CONFIG_SCI5_BITS=8
CONFIG_SCI5_PARITY=0
CONFIG_SCI5_2STOP=0
CONFIG_SCI5_RXBUFSIZE=512
CONFIG_SCI5_TXBUFSIZE=512

CONFIG_RZV_SCI9=y
CONFIG_SCI9_SERIALDRIVER=y
CONFIG_SCI9_BAUD=9600
CONFIG_SCI9_BITS=8
CONFIG_SCI9_PARITY=0
CONFIG_SCI9_2STOP=0
CONFIG_SCI9_RXBUFSIZE=512
CONFIG_SCI9_TXBUFSIZE=512

# Debug
CONFIG_DEBUG_ALERT=y
CONFIG_DEBUG_ERROR=y
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_FULLOPT=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_DEBUG_SYMBOLS_LEVEL="-g3"
CONFIG_DEBUG_OPTLEVEL="-O0"

# HWTEST app
CONFIG_TESTING_RZV_HWTEST=y
CONFIG_TESTING_RZV_HWTEST_MODE_HIL_FULL=y
CONFIG_TESTING_RZV_HWTEST_PROGNAME="hwtest"
CONFIG_TESTING_RZV_HWTEST_PRIORITY=100
CONFIG_TESTING_RZV_HWTEST_STACKSIZE=8192
