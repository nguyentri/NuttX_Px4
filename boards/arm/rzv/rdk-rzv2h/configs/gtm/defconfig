#
# Configuration for GTM Timer Testing on RDK-RZV2H
# Based on NSH configuration with timer driver support added
#
CONFIG_ARCH="arm"
CONFIG_ARCH_BOARD="rdk-rzv2h"
CONFIG_ARCH_BOARD_RDK_RZV2H=y
CONFIG_ARCH_CHIP="rzv"
CONFIG_ARCH_CHIP_RZV=y
CONFIG_ARCH_CHIP_R9A09G057=y
CONFIG_ARMV7R_TOOLCHAIN_GNU_EABI=y
CONFIG_ARCH_STACKDUMP=y
CONFIG_ARMV7R_DCACHE=y
CONFIG_ARMV7R_DTCM=y
CONFIG_ARMV7R_ICACHE=y
CONFIG_ARMV7R_ITCM=y
CONFIG_BINFMT_DISABLE=y
CONFIG_BOARD_LOOPSPERMSEC=200000
CONFIG_BUILTIN=y
CONFIG_FS_PROCFS=y
CONFIG_IDLETHREAD_STACKSIZE=2048
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_INTELHEX_BINARY=y
CONFIG_LIBC_LOCALTIME=y
CONFIG_LINE_MAX=64
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_DISABLE_IFUPDOWN=y
CONFIG_NSH_FILEIOSIZE=512
CONFIG_NSH_READLINE=y
CONFIG_RZV_DTCM=16
CONFIG_RZV_ITCM=16
CONFIG_RAM_SIZE=524288
CONFIG_RAM_START=0x22060000
CONFIG_RAW_BINARY=y
CONFIG_SCHED_BACKTRACE=y
CONFIG_START_DAY=19
CONFIG_START_MONTH=12
CONFIG_START_YEAR=2025
CONFIG_SYSTEM_NSH=y
CONFIG_SYSTEM_NSH_PRIORITY=100
CONFIG_SYSTEM_NSH_STACKSIZE=2048
CONFIG_USEC_PER_TICK=1000
CONFIG_SPINLOCK=y

# NSH Library - Use SCI1 for command interface
CONFIG_NSH_LIBRARY=y
CONFIG_NSH_CONSOLE=y
CONFIG_NSH_UARTDEV="/dev/ttyS0"
CONFIG_NSH_CONDEV="/dev/ttyS0"

# Core Specific Configuration
CONFIG_RZV2H_BUILD_CR8_0=y

# Clocking Configuration
CONFIG_RZV_CLOCK_PLL=y

# Serial Configuration (SCI1 for NSH console)
CONFIG_SERIAL=y
CONFIG_STANDARD_SERIAL=y
CONFIG_SCI1_SERIALDRIVER=y
CONFIG_SCI1_SERIAL_CONSOLE=y
CONFIG_SCI1_RXBUFSIZE=256
CONFIG_SCI1_TXBUFSIZE=256
CONFIG_SCI1_BAUD=115200
CONFIG_SCI1_BITS=8
CONFIG_SCI1_PARITY=0
CONFIG_SCI1_2STOP=0
CONFIG_RZV_SCI1=y

# Console support (SCI1 will be console)
CONFIG_DEV_CONSOLE=y
CONFIG_SERIAL_CONSOLE=y

# Debug features
CONFIG_DEBUG_ALERT=y
CONFIG_DEBUG_ERROR=y
CONFIG_DEBUG_WARN=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_FULLOPT=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_DEBUG_SYMBOLS_LEVEL="-g3"
CONFIG_DEBUG_OPTLEVEL="-O0"

# Timer debugging
CONFIG_DEBUG_TIMER=y
CONFIG_DEBUG_TIMER_ERROR=y
CONFIG_DEBUG_TIMER_WARN=y
CONFIG_DEBUG_TIMER_INFO=y

# FPU Configuration
CONFIG_ARCH_FPU=y
CONFIG_ARCH_DPFPU=y

# Timer Driver Support
CONFIG_TIMER=y
CONFIG_TIMER_ARCH=y

# RZV GTM Timer Configuration
CONFIG_RZV_GTM=y
CONFIG_RZV_GTM0_TIMER=y
CONFIG_RZV_GTM2_TIMER=y

# Timer test application
CONFIG_EXAMPLES_TIMER=y
CONFIG_EXAMPLES_TIMER_DEVNAME="/dev/timer0"
CONFIG_EXAMPLES_TIMER_INTERVAL=1000000
CONFIG_EXAMPLES_TIMER_DELAY=100000
CONFIG_EXAMPLES_TIMER_NSAMPLES=20
CONFIG_EXAMPLES_TIMER_SIGNO=17
CONFIG_EXAMPLES_TIMER_STACKSIZE=2048
CONFIG_EXAMPLES_TIMER_PRIORITY=100
