# ===== SCI-I2C CONFIGURATION =====
#
# Enables SCI3 as Simple-I2C master (bus 13).
# Kconfig enforces: RZV_SCI3_I2C requires !RZV_SCI3 && !RZV_SCI3_SPI.
# RZV_SCI3 (UART) is NOT set in this defconfig, satisfying the mutex.
#
# Schematic note: the RDK-RZV2H GY-912 connector routes to RIIC2, not SCI.
# SCI3 is used as a synthetic smoke target. "i2c probe -b 13" will return
# an empty device list (no slave) — this confirms the driver is alive and
# the bus is functional. No hang or panic is acceptable.
#
CONFIG_I2C=y
CONFIG_I2C_TRANSFER=y

# SCI-I2C master driver (Phase 02/03)
CONFIG_RZV_SCI_I2C=y
CONFIG_RZV_SCI_PCLK_HZ=100000000
CONFIG_RZV_SCI3_I2C=y

# Debug I2C
CONFIG_DEBUG_I2C=y
CONFIG_DEBUG_I2C_INFO=y

# I2C tool — enables "i2c bus" and "i2c probe" NSH commands
CONFIG_SYSTEM_I2CTOOL=y
CONFIG_I2CTOOL_MINBUS=13
CONFIG_I2CTOOL_MAXBUS=13
CONFIG_I2CTOOL_MINADDR=0x03
CONFIG_I2CTOOL_MAXADDR=0x77
CONFIG_I2CTOOL_MAXRETRIES=3
CONFIG_I2CTOOL_DEFFREQ=100000
