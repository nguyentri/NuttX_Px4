# ##############################################################################
# boards/arm/rzv/rdk-rzv2h/Kconfig
#
# Kconfig for the RDK-RZV2H board support package for the RZV2H MPU.
#
if ARCH_BOARD_RDK_RZV2H

config BOARD_RDK_RZV2H
    bool "RDK-RZV2H Board Support"
    help
      Enable support for the RDK-RZV2H board based on the RZV2H MPU.

endif

config RZV2H_EXAMPLE_SUPPORT
    bool "RDK-RZV2H Example Support"
    default y
    depends on ARCH_BOARD_RDK_RZV2H
    help
      Enable support for various application examples for the RDK-RZV2H board.
      Disable when building with PX4 firmware.

config RZV2H_SPI_LOOPBACK_EXAMPLE
    bool "SPI loopback test example"
    default n
    depends on RZV_SPI && RZV2H_EXAMPLE_SUPPORT
    ---help---
      Enable SPI internal loopback test example for verifying
      SPI driver functionality on RDK-RZV2H board.

config RZV2H_I2C_GY912_EXAMPLE
    bool "I2C GY-912 sensor example"
    default n
    depends on RZV_RIIC && RZV2H_EXAMPLE_SUPPORT
    ---help---
      Enable the GY-912 sensor module example application. This example
      demonstrates I2C communication with the ICM-20948 9-axis IMU and
      BMP388 pressure sensor on the GY-912 module using the RIIC interface.

config RZV2H_SPI_GY921_EXAMPLE
    bool "SPI GY-921 sensor example"
    default n
    depends on RZV_SPI && RZV2H_EXAMPLE_SUPPORT
    ---help---
      Enable the GY-921 sensor module example application. This example
      demonstrates SPI communication with MPU-9250 9-axis IMU sensor.

config RZV2H_PWM_ONESHOT_EXAMPLE
    bool "GPT PWM oneshot mode example"
    default n
    depends on RZV_PWM && RZV2H_EXAMPLE_SUPPORT
    ---help---
      Enable GPT PWM oneshot mode example for verifying oneshot
      functionality on RDK-RZV2H board.

config RZV2H_ADC_EXAMPLE
    bool "ADC test example"
    default n
    depends on RZV_ADC && RZV2H_EXAMPLE_SUPPORT
    ---help---
      Enable ADC test example for verifying ADC driver functionality
      on RDK-RZV2H board.

# ##############################################################################