include $(TOPDIR)/.config
include $(TOPDIR)/tools/Config.mk

# Include appropriate toolchain definitions based on build type
ifeq ($(CONFIG_RZV2H_BUILD_CM33),y)
  include $(TOPDIR)/arch/arm/src/armv8-m/Toolchain.defs
else
  include $(TOPDIR)/arch/arm/src/armv7-r/Toolchain.defs
endif

# Determine linker script based on build type
ifeq ($(CONFIG_RZV2H_BUILD_CR8_0),y)
  LDSCRIPT = rdk-rzv2h_cr8_0.ld
else ifeq ($(CONFIG_RZV2H_BUILD_CR8_1),y)
  LDSCRIPT = rdk-rzv2h_cr8_1.ld
else ifeq ($(CONFIG_RZV2H_BUILD_CM33),y)
  LDSCRIPT = rdk-rzv2h_cm33.ld
endif

ARCHSCRIPT += $(BOARD_DIR)$(DELIM)scripts$(DELIM)$(LDSCRIPT)

# Compile flags
CFLAGS := $(ARCHCFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS) -pipe
CPICFLAGS = $(ARCHPICFLAGS) $(CFLAGS)
CXXFLAGS := $(ARCHCXXFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHXXINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS) -pipe
CXXPICFLAGS = $(ARCHPICFLAGS) $(CXXFLAGS)
CPPFLAGS := $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
AFLAGS := $(CFLAGS) -D__ASSEMBLY__

# Linker flags
NXFLATLDFLAGS1 = -r -d -warn-common
NXFLATLDFLAGS2 = $(NXFLATLDFLAGS1) -T$(TOPDIR)/binfmt/libnxflat/gnu-nxflat-pcrel.ld -no-check-sections
LDNXFLATFLAGS = -e main -s 2048

# ELF module flags
LDELFFLAGS = -r -e main
ifeq ($(CONFIG_CYGWIN_WINTOOL),y)
  LDELFFLAGS += -T "${shell cygpath -w $(BOARD_DIR)$(DELIM)scripts$(DELIM)gnu-elf.ld}"
else
  LDELFFLAGS += -T $(BOARD_DIR)$(DELIM)scripts$(DELIM)gnu-elf.ld
endif

# Board-specific flags
HOSTCC = gcc
HOSTINCLUDES = -I.
HOSTCFLAGS = -Wall -Wstrict-prototypes -Wshadow -Wundef -g -pipe
HOSTLDFLAGS =

# Post-build: emit the Renesas split image (header+itcm+sram+sdram) + SREC.
# The flat nuttx.bin that Unix.mk creates is unusable for CR8 boot (huge
# padding across DDR VMAs); the split image + SREC below is what the CA55
# SCIF-boot / ATF loader consumes.
ifeq ($(CONFIG_RZV2H_BUILD_CR8_0),y)
  RZV_CORE_TAG = cr8_0
else ifeq ($(CONFIG_RZV2H_BUILD_CR8_1),y)
  RZV_CORE_TAG = cr8_1
endif

ifneq ($(RZV_CORE_TAG),)
define POSTBUILD
	$(Q) OBJCOPY="$(OBJCOPY)" \
	    $(BOARD_DIR)$(DELIM)scripts$(DELIM)rzv2h-cr8-split-image-postbuild.sh \
	    $(BIN) $(RZV_CORE_TAG)
endef
endif
