   # General Purpose Timers - 8 channels
   select RA_HAVE_GPT
   select RA_HAVE_GPT0
   select RA_HAVE_GPT1
   select RA_HAVE_GPT2
   select RA_HAVE_GPT3
   select RA_HAVE_GPT4
   select RA_HAVE_GPT5
   select RA_HAVE_GPT6
   select RA_HAVE_GPT7
   # Low Power Timers
   select RA_HAVE_AGT
   select RA_HAVE_AGT0
   select RA_HAVE_AGT1
   select RA_HAVE_ULPT
   select RA_HAVE_ULPT0
   select RA_HAVE_ULPT1
