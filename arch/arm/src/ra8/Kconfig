endmenu

menu "Peripheral Clock Sources"

choice
   prompt "SCI Clock Source"
   default RA_SCICLK_SOURCE_PLL1P if RA_SCI && (RA_CLOCK_PLL || RA_CLOCK_PLL1P)
   default RA_SCICLK_SOURCE_HOCO if RA_SCI
   default RA_SCICLK_SOURCE_DISABLED
   help
     Select SCI (Serial Communication Interface) clock source.

config RA_SCICLK_SOURCE_HOCO
   bool "HOCO (High-Speed On-Chip Oscillator)"

config RA_SCICLK_SOURCE_MOCO
   bool "MOCO (Medium-Speed On-Chip Oscillator)"

config RA_SCICLK_SOURCE_LOCO
   bool "LOCO (Low-Speed On-Chip Oscillator)"

config RA_SCICLK_SOURCE_MAIN_OSC
   bool "Main Oscillator (External Crystal)"

config RA_SCICLK_SOURCE_PLL1P
   bool "PLL1P (High Performance)"
   depends on RA_CLOCK_PLL || RA_CLOCK_PLL1P

config RA_SCICLK_SOURCE_PLL1Q
   bool "PLL1Q (PLL1 Q output)"
   depends on RA_CLOCK_PLL || RA_CLOCK_PLL1P

config RA_SCICLK_SOURCE_PLL2P
   bool "PLL2P (PLL2 P output)"
   depends on RA_PLL2_ENABLE

config RA_SCICLK_SOURCE_PLL2Q
   bool "PLL2Q (PLL2 Q output)"
   depends on RA_PLL2_ENABLE

config RA_SCICLK_SOURCE_PLL2R
   bool "PLL2R (PLL2 R output)"
   depends on RA_PLL2_ENABLE



config RA_SCICLK_SOURCE_DISABLED
   bool "Disabled"

endchoice

config RA_SCICLK_DIV
   int "SCI Clock Divider"
   default 2
   range 0 8
   depends on !RA_SCICLK_SOURCE_DISABLED
   help
     SCI clock divider (0=/1, 1=/2, 2=/4, 3=/6, 4=/8, 5=/3, 6=/5, 7=/10, 8=/16).
     Default: 2 (/4) gives 90MHz from 360MHz PLL1P.

choice
   prompt "SPI Clock Source"
   default RA_SPICLK_SOURCE_PLL1P if RA_SPI && (RA_CLOCK_PLL || RA_CLOCK_PLL1P)
   default RA_SPICLK_SOURCE_HOCO if RA_SPI
   default RA_SPICLK_SOURCE_DISABLED
   help
     Select SPI clock source.

config RA_SPICLK_SOURCE_HOCO
   bool "HOCO (High-Speed On-Chip Oscillator)"

config RA_SPICLK_SOURCE_MOCO
   bool "MOCO (Medium-Speed On-Chip Oscillator)"

config RA_SPICLK_SOURCE_LOCO
   bool "LOCO (Low-Speed On-Chip Oscillator)"

