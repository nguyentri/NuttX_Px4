   prompt "PLL2 Source Clock"
   default RA_PLL2_SOURCE_MAIN_OSC
   help
     Select the PLL2 input source clock.

config RA_PLL2_SOURCE_HOCO
   bool "HOCO (High-Speed On-Chip Oscillator)"

