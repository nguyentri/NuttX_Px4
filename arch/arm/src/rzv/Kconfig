   int "SPI1 RX DMA channel"
   default -1
   range -1 79
   ---help---
     DMA channel for SPI1 receive operations (-1 = no DMA).

config RZV_DMAC_SPI1_TX_CHANNEL
   int "SPI1 TX DMA channel"
   default -1
   range -1 79
   ---help---
     DMA channel for SPI1 transmit operations (-1 = no DMA).

config RZV_DMAC_ADC_CHANNEL
   int "ADC DMA channel"
   default -1
   range -1 79
   ---help---
     DMA channel for ADC data transfer (-1 = no DMA).

config RZV_DMAC_SDHI_CHANNEL
   int "SDHI DMA channel"
   default -1
   range -1 79
   ---help---
     DMA channel for SDHI (SD card) operations (-1 = no DMA).
     Recommended: Use DMAC0 channels (0-15) for high-speed operations.

endif # RZV_DMAC

# CONFIG_RZV_DTC intentionally removed.
# DTC peripheral does NOT exist on RZ/V2H (R9A09G057H). There is no
# r_dtc* source under the FSP rzv/ tree and no DTC iodefine under
# R9A09G057H/. The old RZV_DTC_BASE (0x11400400) overlapped DMAC0 group-1
# registers and would have caused silent register corruption.

config RZV_TIMER
   bool
   default n

