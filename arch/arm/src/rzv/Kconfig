# SCI FIFO Configuration

config RZV_SCI_FIFO_MODE
   bool "Enable SCI FIFO mode"
   default y
   depends on RZV_UART_SCI
   ---help---
     Enable 16-byte FIFO mode for SCI-B UART channels.
     This significantly reduces interrupt load at high baud rates.

     Performance improvement:
     - Without FIFO: ~92,160 interrupts/sec at 921600 baud
     - With FIFO: ~5,760 interrupts/sec (16x reduction)

config RZV_SCI_FIFO_RX_TRIGGER
   int "RX FIFO trigger level"
   default 1
   range 1 15
   depends on RZV_SCI_FIFO_MODE
   ---help---
     RX interrupt triggers when FIFO contains >= this many bytes.
     Lower values = lower latency, higher interrupt rate.
     Higher values = fewer interrupts, may increase latency.

     Recommended: 1 for low latency (console), 8-15 for throughput

config RZV_SCI_FIFO_TX_TRIGGER
   int "TX FIFO trigger level"
   default 15
   range 0 15
   depends on RZV_SCI_FIFO_MODE
   ---help---
     TX interrupt triggers when FIFO has <= this many bytes free.
     Higher values = fewer interrupts, better throughput.

     Recommended: 15 (maximum efficiency)

config RZV_SERIAL_RXDMA_BUFFER_SIZE
   int "RX DMA buffer size"
   default 256
   range 64 4096
   depends on SERIAL_RXDMA
   ---help---
     Size of circular buffer for RX DMA transfers.
     Larger buffers reduce DMA interrupt frequency but increase
     memory usage and potential latency.

     Recommended: 256 (balances performance and memory)

# Serial Communications Interface with FIFO (SCIF)
# Backed by rzv_scif.c (FSP-aligned port). Enables all SCIF channels
# through CONFIG_RZV_UART_SCIF. Mutually compatible at file level with
# RZV_UART_SCI but typically only one is selected as the console.

config RZV_UART_SCIF
   bool
   default n

config RZV_SCIF0
   bool "SCIF0"
   default n
   depends on RZV_HAVE_SCIF0_UART
   select RZV_UART_SCIF

config RZV_SCIF1
   bool "SCIF1"
   default n
   depends on RZV_HAVE_SCIF1_UART
   select RZV_UART_SCIF

config RZV_SCIF2
   bool "SCIF2"
   default n
   depends on RZV_HAVE_SCIF2_UART
   select RZV_UART_SCIF

config RZV_SCIF3
   bool "SCIF3"
   default n
   depends on RZV_HAVE_SCIF3_UART
   select RZV_UART_SCIF

config RZV_SCIF4
   bool "SCIF4"
   default n
   depends on RZV_HAVE_SCIF4_UART
   select RZV_UART_SCIF

