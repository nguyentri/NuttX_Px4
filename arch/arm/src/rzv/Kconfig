config RZV_DMAC_SDHI_CHANNEL
   int "SDHI DMA channel"
   default -1
   range -1 79
   ---help---
     DMA channel for SDHI (SD card) operations (-1 = no DMA).
     Recommended: Use DMAC0 channels (0-15) for high-speed operations.

endif # RZV_DMAC

config RZV_DTC
   bool "Data Transfer Controller (DTC)"
   default n
   depends on RZV_HAVE_DMAC
   ---help---
     Enable support for the RZV2H Data Transfer Controller (DTC/XDTC).
     The DTC provides hardware-triggered data transfers without CPU
     intervention. It supports normal, repeat, and block transfer modes
     with configurable source and destination address modes.

