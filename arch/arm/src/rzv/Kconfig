# RZV2H Group Configuration
config RZV2H_GROUP
   bool
   default y
   help
     Enables the RZV2H group of features and peripherals.
     This is required for all RZV2H configurations.

config RZV_FAMILY
   bool
   default y
   ---help---
     RZV family of Renesas MPUs

if !RZV2H_BUILD_CM33
# Cortex-R8 configuration (CR8_0/CR8_1 cores)

config ARCH_CORTEXR8_SELECTED
   bool
   default y
   select ARCH_CORTEXR8
   select ARCH_HAVE_FPU
   select ARCH_HAVE_THUMB
   select ARCH_HAVE_DPFPU
   select ARCH_HAVE_MPU
   select ARMV7R_MEMINIT

endif # !RZV2H_BUILD_CM33

if RZV2H_BUILD_CM33
# Cortex-M33 configuration

config ARCH_CORTEXM33_SELECTED
   bool
   default y
   select ARCH_CORTEXM33
   select ARCH_HAVE_FPU
   select ARCH_HAVE_DPFPU
   select ARMV8M_HAVE_ICACHE
   select ARMV8M_HAVE_DCACHE
   select ARM_HAVE_MPU_UNIFIED

endif # RZV2H_BUILD_CM33

# Core Selection (must be choice block for mutual exclusion)
choice
    prompt "RZV2H Core Selection"
    default RZV2H_BUILD_CR8_0

config RZV2H_BUILD_CR8_0
    bool "Build for CR8_0 core"
    help
      Build for the CR8_0 core of the RZV2H.
      This is the default core for the RDK-RZV2H board.
      Uses Cortex-R8 (ARMv7-R) architecture.

config RZV2H_BUILD_CR8_1
    bool "Build for CR8_1 core"
    help
      Build for the CR8_1 core of the RZV2H.
      This is the secondary core for the RDK-RZV2H board.
      Uses Cortex-R8 (ARMv7-R) architecture.

config RZV2H_BUILD_CM33
    bool "Build for CM33 core"
    help
      Build for the CM33 core of the RZV2H.
      This core is used for TrustZone security features and real-time control.
      Uses Cortex-M33 (ARMv8-M) architecture with optional FPU and DSP.

endchoice

if RZV2H_BUILD_CM33

config RZV2H_CM33_ATCM_SIZE
   int "CM33 ATCM size (KB)"
   default 128
   help
     Size of CM33 Tightly-Coupled Memory A (ATCM) in KB.
     RZV2H CM33 has 128KB ATCM at 0x00000000.

config RZV2H_CM33_BTCM_SIZE
   int "CM33 BTCM size (KB)"
   default 128
   help
     Size of CM33 Tightly-Coupled Memory B (BTCM) in KB.
     RZV2H CM33 has 128KB BTCM at 0x20000000.

config RZV2H_CM33_SRAM_BASE
   hex "CM33 System RAM base address"
   default 0x22000000
   help
     Base address of CM33 system RAM.
     RZV2H allocates 512KB RAM for CM33 at 0x22000000.

config RZV2H_CM33_SRAM_SIZE
   int "CM33 System RAM size (KB)"
   default 512
   help
     Size of CM33 system RAM in KB.

endif # RZV2H_BUILD_CM33

# Clock Configuration

menu "RZV2H Clock Configuration"

config RZV_CLOCK_CONFIG_ENABLE
   bool "Enable custom clock configuration"
   default n
   ---help---
     Enable custom clock configuration options. When disabled, the clock
     system uses reset defaults which match the standard board configuration.

config RZV_OSC_FREQUENCY
   int "Main oscillator frequency (Hz)"
   default 24000000
   depends on RZV_CLOCK_CONFIG_ENABLE
   ---help---
     Main oscillator (OSC) frequency in Hz. Default is 24 MHz for RDK-RZV2H.

config RZV_OSC2_FREQUENCY
   int "Secondary oscillator frequency (Hz)"
   default 4800000
   depends on RZV_CLOCK_CONFIG_ENABLE
   ---help---
     Secondary oscillator (OSC2) frequency in Hz. Default is 4.8 MHz.

config RZV_CLOCK_RETRY_COUNT
   int "Clock operation retry count"
   default 3
   range 0 10
   ---help---
     Number of retry attempts for clock enable/disable and reset operations.
     Set to 0 to disable retries. Default is 3 retries with exponential backoff.

config RZV_CLOCK_ENABLE_TIMEOUT
   int "Clock enable timeout (10us units)"
   default 1000
   range 100 10000
   ---help---
     Timeout for clock enable operations in 10-microsecond units.
     Default is 1000 (10ms). Increase if clock enable operations timeout.

config RZV_CLOCK_PLL_TIMEOUT
   int "PLL lock timeout (10us units)"
   default 10000
   range 1000 100000
   ---help---
     Timeout for PLL lock operations in 10-microsecond units.
     Default is 10000 (100ms). PLLs typically lock within a few milliseconds.

config RZV_CLOCK_DEBUG
   bool "Enable clock debug logging"
   default n
   depends on DEBUG_FEATURES
   ---help---
     Enable detailed debug logging for clock operations including register
     dumps on failures. Useful for diagnosing clock configuration issues.

config RZV_XTAL_FREQ
   int "Main oscillator (XTAL/OSC) frequency override (Hz)"
   default 24000000
   ---help---
     Main oscillator frequency in Hz.  Default is 24 MHz for RDK-RZV2H.
     Override if your board uses a different crystal.
     Consumed by RZV_MAIN_CLOCK_HZ in rzv_clock.h.
     audit Low-14.

config RZV_CPU_CLOCK_HZ
   int "CR8 CPU clock frequency override (Hz)"
   default 800000000
   ---help---
     Expected CR8 (I6CLK) frequency in Hz after bootloader configures
     dividers.  Used as compile-time fallback when CDDIV readback is not
     yet decoded.  PX4 HRT and USEC_PER_TICK depend on this being accurate.
     Default: 800 MHz (I6CLK from PLLCLN/2).
     audit Low-14 / High PX4 compatibility.

config RZV_PCLK_0_HZ
   int "P0CLK peripheral bus 0 frequency override (Hz)"
   default 100000000
   ---help---
     Expected P0CLK frequency in Hz.  Used for SCI/SPI/I2C baud divisor
     calculations.  Default: 100 MHz.
     audit Low-14.

config RZV_PCLK_5_HZ
   int "P5CLK peripheral bus 5 frequency override (Hz)"
   default 100000000
   ---help---
     Expected P5CLK frequency in Hz.  Default: 100 MHz.
     audit Low-14.

config RZV_CLOCK_RESET_ASSERT_TIMEOUT
   int "Reset assert timeout (10us units)"
   default 500
   range 50 5000
   ---help---
     Timeout for reset assert operations in 10-microsecond units.
     Default is 500 (5ms).
     audit Medium-11 per-op timeouts.

config RZV_CLOCK_RESET_RELEASE_TIMEOUT
   int "Reset release timeout (10us units)"
   default 1000
   range 100 10000
   ---help---
     Timeout for reset release (deassert) operations in 10-microsecond units.
     Default is 1000 (10ms).
     audit Medium-11 per-op timeouts.

config RZV_INIT_PLLDDR
   bool "Initialize PLLDDR0/1 from NuttX (expert)"
   default n
   ---help---
     Enable NuttX-side initialization of PLLDDR0 and PLLDDR1.
     WARNING: DDR PLLs are normally initialized by TF-A before NuttX boots.
     Enabling this when TF-A already initialized the DDR PLLs will cause
     DDR instability.  Only enable on platforms where TF-A does NOT init DDR.
     audit Low-13.

endmenu

