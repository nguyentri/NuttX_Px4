   select RZV_HAVE_SPI0
   select RZV_HAVE_SPI1
   select RZV_HAVE_SPI2
   select RZV_HAVE_CAN0
   select RZV_HAVE_CAN1
   select RZV_HAVE_ETHERC_MII
   select RZV_HAVE_ETHERC_RMII
   select RZV_HAVE_USBFS
   select RZV_HAVE_OSPI
   select RZV_HAVE_SSIE
   select RZV_HAVE_GTM
   select RZV_HAVE_GTM0
   select RZV_HAVE_GTM1
   select RZV_HAVE_GTM2
   select RZV_HAVE_GTM3
   select RZV_HAVE_GTM4
   select RZV_HAVE_GTM5
   select RZV_HAVE_GTM6
   select RZV_HAVE_GTM7
   select RZV_HAVE_OSTM
   select RZV_HAVE_OSTM0
   select RZV_HAVE_OSTM1
   select RZV_HAVE_OSTM2
   select RZV_HAVE_WDT
   select RZV_HAVE_ADC12
   select RZV_HAVE_DAC12
   select RZV_HAVE_ACMPHS
   select RZV_HAVE_GPT
   select RZV_HAVE_GPT0
   select RZV_HAVE_GPT1
   select RZV_HAVE_GPT2
   select RZV_HAVE_GPT3
   select RZV_HAVE_GPT4
   select RZV_HAVE_GPT5
   select RZV_HAVE_GPT6
   select RZV_HAVE_GPT7

