# Serial Communications Interface with FIFO (SCIF) - legacy compatibility

config RZV_SCIF0
   bool "SCIF0"
   default n
   depends on RZV_HAVE_SCIF0_UART
   select RZV_UART_SCI
   select UART0_SERIALDRIVER

config RZV_SCIF1
   bool "SCIF1"
   default n
   depends on RZV_HAVE_SCIF1_UART
   select RZV_UART_SCI
   select UART1_SERIALDRIVER

config RZV_SCIF2
   bool "SCIF2"
   default n
   depends on RZV_HAVE_SCIF2_UART
   select RZV_UART_SCI
   select UART2_SERIALDRIVER

config RZV_SCIF3
   bool "SCIF3"
   default n
   depends on RZV_HAVE_SCIF3_UART
   select RZV_UART_SCI
   select UART3_SERIALDRIVER

config RZV_SCIF4
   bool "SCIF4"
   default n
   depends on RZV_HAVE_SCIF4_UART
   select RZV_UART_SCI
   select UART4_SERIALDRIVER

config RZV_RIIC
   bool
   default n
   select I2C

config RZV_RIIC0
   bool "I2C0 (RIIC0)"
   default n
   depends on RZV_HAVE_I2C0
   select RZV_RIIC

config RZV_RIIC1
   bool "I2C1 (RIIC1)"
   default n
   depends on RZV_HAVE_I2C1
   select RZV_RIIC

config RZV_RIIC2
   bool "I2C2 (RIIC2)"
   default n
   depends on RZV_HAVE_I2C2
   select RZV_RIIC

config RZV_RIIC3
   bool "I2C3 (RIIC3)"
   default n
   depends on RZV_HAVE_I2C3
   select RZV_RIIC

config RZV_SPI
   bool
   default n

config RZV_SPI0
   bool "SPI0"
   default n
   depends on RZV_HAVE_SPI0
   select RZV_SPI

config RZV_SPI1
   bool "SPI1"
   default n
   depends on RZV_HAVE_SPI1
   select RZV_SPI

config RZV_SPI2
   bool "SPI2"
   default n
   depends on RZV_HAVE_SPI2
   select RZV_SPI

config RZV_DMA
   bool "DMA support"
   default n
   depends on RZV_HAVE_DMAC
   select ARCH_DMA

config RZV_TIMER
   bool
   default n

config RZV_OSTM0
   bool "OS Timer 0"
   default n
   depends on RZV_HAVE_OSTM0
   select RZV_TIMER

config RZV_OSTM1
   bool "OS Timer 1"
   default n
   depends on RZV_HAVE_OSTM1
   select RZV_TIMER

config RZV_OSTM2
   bool "OS Timer 2"
   default n
   depends on RZV_HAVE_OSTM2
   select RZV_TIMER

config RZV_GPT
   bool "General PWM Timer (GPT)"
   default n
   depends on RZV_HAVE_GPT
   select PWM
   ---help---
     Enable support for the RZV General PWM Timer (GPT) peripheral.

config RZV_GPT_PWM
   bool "GPT PWM support"
   default n
   depends on RZV_GPT
   select PWM
   ---help---
     Enable PWM functionality for the RZV GPT peripheral.

config RZV_GPT_TIMER
   bool "GPT Timer support"
   default n
   depends on RZV_GPT
   select TIMER
   ---help---
     Enable Timer functionality for the RZV GPT peripheral.

config RZV_GPT_ONESHOT
   bool "GPT One-shot mode support"
   default n
   depends on RZV_GPT_PWM
   select PWM_PULSECOUNT
   ---help---
     Enable One-shot mode for the RZV GPT PWM driver.

config RZV_GPT0
   bool "GPT0"
   default n
   depends on RZV_HAVE_GPT0 && RZV_GPT
   ---help---
     Enable GPT0 channel.

config RZV_GPT1
   bool "GPT1"
   default n
   depends on RZV_HAVE_GPT1 && RZV_GPT
   ---help---
     Enable GPT1 channel.

config RZV_GPT2
   bool "GPT2"
   default n
   depends on RZV_HAVE_GPT2 && RZV_GPT
   ---help---
     Enable GPT2 channel.

config RZV_GPT3
   bool "GPT3"
   default n
   depends on RZV_HAVE_GPT3 && RZV_GPT
   ---help---
     Enable GPT3 channel.

config RZV_GPT4
   bool "GPT4"
   default n
   depends on RZV_HAVE_GPT4 && RZV_GPT
   ---help---
     Enable GPT4 channel.

config RZV_GPT5
   bool "GPT5"
   default n
   depends on RZV_HAVE_GPT5 && RZV_GPT
   ---help---
     Enable GPT5 channel.

config RZV_GPT6
   bool "GPT6"
   default n
   depends on RZV_HAVE_GPT6 && RZV_GPT
   ---help---
     Enable GPT6 channel.

config RZV_GPT7
   bool "GPT7"
   default n
   depends on RZV_HAVE_GPT7 && RZV_GPT
   ---help---
     Enable GPT7 channel.

config RZV_ADC
   bool "ADC support"
   default n
   depends on RZV_HAVE_ADC12

config RZV_DAC
   bool "DAC support"
   default n
   depends on RZV_HAVE_DAC12

config RZV_ETHERNET
   bool "Ethernet support"
   default n
   depends on RZV_HAVE_ETHERC_MII || RZV_HAVE_ETHERC_RMII
   select NETDEVICES
