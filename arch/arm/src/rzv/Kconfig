#
# RZV2H MPU Configuration Options
#

comment "RZV2H MPU Selection"

choice
   prompt "RZV2H Chip Selection"
   default ARCH_CHIP_R9A09G057
   depends on ARCH_CHIP_RZV

config ARCH_CHIP_R9A09G057
   bool "R9A09G057 (BGA324)"
   select RZV_FAMILY
   select RZV2H_GROUP
   select RZV_HAVE_SCIF0_UART
   select RZV_HAVE_SCIF1_UART
   select RZV_HAVE_SCIF2_UART
   select RZV_HAVE_SCIF3_UART
   select RZV_HAVE_SCIF4_UART
   select RZV_HAVE_I2C0
   select RZV_HAVE_I2C1
   select RZV_HAVE_I2C2
   select RZV_HAVE_I2C3
   select RZV_HAVE_DMAC
   select RZV_HAVE_SPI0
   select RZV_HAVE_SPI1
   select RZV_HAVE_SPI2
   select RZV_HAVE_CAN0
   select RZV_HAVE_CAN1
   select RZV_HAVE_ETHERC_MII
   select RZV_HAVE_ETHERC_RMII
   select RZV_HAVE_USBFS
   select RZV_HAVE_OSPI
   select RZV_HAVE_SSIE
   select RZV_HAVE_GTM
   select RZV_HAVE_GTM0
   select RZV_HAVE_GTM1
   select RZV_HAVE_GTM2
   select RZV_HAVE_GTM3
   select RZV_HAVE_GTM4
   select RZV_HAVE_GTM5
   select RZV_HAVE_GTM6
   select RZV_HAVE_GTM7
   select RZV_HAVE_OSTM
   select RZV_HAVE_OSTM0
   select RZV_HAVE_OSTM1
   select RZV_HAVE_OSTM2
   select RZV_HAVE_WDT
   select RZV_HAVE_ADC12
   select RZV_HAVE_DAC12
   select RZV_HAVE_ACMPHS
   select RZV_HAVE_GPT
   select RZV_HAVE_GPT0
   select RZV_HAVE_GPT1
   select RZV_HAVE_GPT2
   select RZV_HAVE_GPT3
   select RZV_HAVE_GPT4
   select RZV_HAVE_GPT5
   select RZV_HAVE_GPT6
   select RZV_HAVE_GPT7

endchoice

# RZV2H Group Configuration
config RZV2H_GROUP
   bool
   default y
   help
     Enables the RZV2H group of features and peripherals.
     This is required for all RZV2H configurations.

config RZV_FAMILY
   bool
   default y
   select ARCH_CORTEXR8
   select ARCH_HAVE_FPU
   select ARCH_HAVE_THUMB
   select ARCH_HAVE_DPFPU
   select ARCH_HAVE_MPU
   select ARMV7R_HAVE_GICv2
   ---help---
     RZV family of Renesas MPUs

config RZV2H_BUILD_CR8_0
    bool "Build for CR8_0 core"
    default y
    help
      Build for the CR8_0 core of the RZV2H.
      This is the default core for the RDK-RZV2H board.

config RZV2H_BUILD_CR8_1
    bool "Build for CR8_1 core"
    default n
    help
      Build for the CR8_1 core of the RZV2H.
      This is the secondary core for the RDK-RZV2H board.

config RZV2H_BUILD_CM33
    bool "Build for CM33 core"
    default n
    help
      Build for the CM33 core of the RZV2H.
      This core is used for TrustZone security features. It is currently not supported.

