# Serial Communication Interface (SCI) - Simple I2C mode

menuconfig RZV_SCI_I2C
   bool "SCI-as-I2C master driver"
   default n
   select I2C
   ---help---
     Enables RZ/V2H SCI-B block in Simple-I2C master mode.
     Each channel is mutually exclusive with UART (RZV_SCIn) and SPI
     (RZV_SCIn_SPI). Selecting I2C disables the matching SPI selection.
     CPU-mode only (no DMAC). Slave mode not supported.

if RZV_SCI_I2C

config RZV_SCI0_I2C
   bool "SCI0 as I2C master"
   default n
   depends on !RZV_SCI0
   ---help---
     Enable SCI0 in Simple-I2C master mode.
     Mutually exclusive with RZV_SCI0 (UART). Selecting this option disables
     RZV_SCI0_SPI.
     Board must define BOARD_SCI0_I2C_SDA_GPIO / BOARD_SCI0_I2C_SCL_GPIO.

config RZV_SCI1_I2C
   bool "SCI1 as I2C master"
   default n
   depends on !RZV_SCI1
