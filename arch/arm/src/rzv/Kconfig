# Serial Communication Interface (SCI) - Simple I2C mode

menuconfig RZV_SCI_I2C
   bool "SCI-as-I2C master driver"
   default n
   select I2C
   ---help---
     Enables RZ/V2H SCI-B block in Simple-I2C master mode.
     FSP ground truth: r_sci_b_i2c.c (Renesas FSP r_sci_b_i2c port).
     Each channel is mutually exclusive with UART (RZV_SCIn) and
     SPI (RZV_SCIn_SPI) — enforced at config time via depends on.
     CPU-mode only (no DMAC). Slave mode not supported.

if RZV_SCI_I2C

config RZV_SCI0_I2C
   bool "SCI0 as I2C master"
   default n
   depends on !RZV_SCI0 && !RZV_SCI0_SPI
   ---help---
     Enable SCI0 in Simple-I2C master mode.
     Mutually exclusive with RZV_SCI0 (UART) and RZV_SCI0_SPI.
     Board must define BOARD_SCI0_I2C_SDA_GPIO / BOARD_SCI0_I2C_SCL_GPIO.

config RZV_SCI1_I2C
   bool "SCI1 as I2C master"
   default n
   depends on !RZV_SCI1 && !RZV_SCI1_SPI
   ---help---
     Enable SCI1 in Simple-I2C master mode.
     Mutually exclusive with RZV_SCI1 (UART) and RZV_SCI1_SPI.
     Board must define BOARD_SCI1_I2C_SDA_GPIO / BOARD_SCI1_I2C_SCL_GPIO.

config RZV_SCI2_I2C
   bool "SCI2 as I2C master"
   default n
   depends on !RZV_SCI2 && !RZV_SCI2_SPI
   ---help---
     Enable SCI2 in Simple-I2C master mode.
     Mutually exclusive with RZV_SCI2 (UART) and RZV_SCI2_SPI.
     Board must define BOARD_SCI2_I2C_SDA_GPIO / BOARD_SCI2_I2C_SCL_GPIO.

config RZV_SCI3_I2C
   bool "SCI3 as I2C master"
   default n
   depends on !RZV_SCI3 && !RZV_SCI3_SPI
   ---help---
     Enable SCI3 in Simple-I2C master mode.
     Mutually exclusive with RZV_SCI3 (UART) and RZV_SCI3_SPI.
     Board must define BOARD_SCI3_I2C_SDA_GPIO / BOARD_SCI3_I2C_SCL_GPIO.

endif # RZV_SCI_I2C

config RZV_DMA
   bool "DMA support"
   default n
   depends on RZV_HAVE_DMAC
   select ARCH_DMA

config RZV_DMAC
   bool "DMAC_B (Direct Memory Access Controller)"
   default n
   depends on RZV_HAVE_DMAC
   select ARCH_DMA
   ---help---
     Enable support for the RZV2H DMAC_B (Direct Memory Access Controller).
     The DMAC_B provides 80 DMA channels (5 units x 16 channels) supporting
     register mode and link mode transfers with hardware and software triggers.
     Features include:
     - Transfer sizes from 1 to 128 bytes
     - Address increment/fixed modes
     - Hardware trigger via ELC events
     - Interrupt-driven operation
     - Priority control per channel

if RZV_DMAC

config RZV_DMAC_DEBUG
   bool "DMAC debug output"
   default n
   depends on DEBUG_FEATURES
   ---help---
     Enable DMAC debug output. This will provide detailed information
     about DMA transfers, channel configuration, and error conditions.

config RZV_DMAC_REGISTER_LEVEL_DEBUG
   bool "DMAC register-level debug"
   default n
   depends on RZV_DMAC_DEBUG
   ---help---
     Enable detailed register-level debugging for DMAC operations.
     This includes register reads/writes and status monitoring.

