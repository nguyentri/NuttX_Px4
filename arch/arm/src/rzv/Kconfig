   default n
   depends on RZV_HAVE_OSTM2
   select RZV_TIMER

# GTM (General Timer Module / OSTM) Configuration

config RZV_GTM
   bool "General Timer Module (GTM/OSTM)"
   default n
   depends on RZV_HAVE_GTM
   select TIMER
   ---help---
     Enable support for the RZV General Timer Module (GTM/OSTM).
     This is a 32-bit free-running timer suitable for high-resolution
     timing applications like PX4 HRT (High Resolution Timer).

config RZV_GTM_CLOCK_FREQUENCY
   int "GTM clock frequency (Hz)"
   default 200000000
   depends on RZV_GTM
   ---help---
     The GTM clock frequency in Hz. Default is 200 MHz.

