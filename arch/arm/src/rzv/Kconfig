   default n
   depends on RZV_PWM
   select PWM_PULSECOUNT
   ---help---
     Enable One-shot mode for the RZV GPT PWM driver.

config RZV_POEG
   bool "POEG (Port Output Enable for GPT) driver"
   default n
   depends on RZV_PWM
   ---help---
     Enable the POEG driver for GPT output protection.
     POEG forces GTIOCA/GTIOCB outputs to inactive state within < 1 PWM
     cycle when a hardware fault (port input, I/O short-circuit) or a
     software stop is triggered.  Required for PX4 arming safety.
     Addresses phase-08 spec High-4 (POEG output disable on fault).
     Default is n (opt-in) — spurious fault inputs can disarm ESCs.

