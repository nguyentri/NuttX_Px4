   bool "R9A09G057 (BGA324)"
   select RZV_FAMILY
   select RZV2H_GROUP
   select RZV_HAVE_SCIF0_UART
   select RZV_HAVE_SCIF1_UART
   select RZV_HAVE_SCIF2_UART
   select RZV_HAVE_SCIF3_UART
   select RZV_HAVE_SCIF4_UART
   select RZV_HAVE_I2C0
   select RZV_HAVE_I2C1
   select RZV_HAVE_I2C2
   select RZV_HAVE_I2C3
