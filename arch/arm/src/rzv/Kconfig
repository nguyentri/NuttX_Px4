config RZV_IPC_RAW
   bool "RZ/V2H raw MHU+SHM IPCC lower half"
   default n
   select IPCC
   ---help---
     Enable the generic raw IPCC lower half driver backed by MHU doorbell
     + shared-memory ring buffers.  Used by CR8↔CR8 (/dev/ipcc1) and
     CR8↔CM33 (/dev/ipcc2) links.  No OpenAMP/virtio dependency.

config RZV_IPC_RAW_RING_ENTRIES
   int "Raw IPCC ring depth (entries per direction)"
   default 16
   range 4 256
   depends on RZV_IPC_RAW
   ---help---
     Number of entries in each ring direction (TX and RX).
     Must be a power of two.

config RZV_IPC_RAW_ENTRY_SIZE
   int "Raw IPCC ring entry payload size (bytes)"
   default 64
   range 16 512
   depends on RZV_IPC_RAW
   ---help---
     Payload bytes per ring entry.  Round to cache-line multiple for
     best cache-maintenance efficiency (recommend 64).

config RZV_IPC_TX_TIMEOUT_MS
   int "Raw IPCC TX-ACK timeout (ms, 0=infinite)"
   default 100
   depends on RZV_IPC_RAW
   ---help---
     Milliseconds to wait for peer TX-ACK before returning -ETIMEDOUT.
     Set 0 for infinite wait (only safe for trusted peers like CR8_1).
     CR8↔CM33 link always uses this timeout regardless of setting because
     CM33 firmware may be absent.

config RZV_IPC_CR8_CR8
   bool "Instantiate /dev/ipcc1 for CR8_0 ↔ CR8_1"
   default n
   depends on RZV_IPC_RAW
   ---help---
     Register a raw IPCC character device at /dev/ipcc1 using MHU
     channels 4/9 and DDR SHM at 0x43800000.

config RZV_IPC_ROLE_INITIATOR
   bool "This core is the ring initiator (zeros SHM on boot)"
   default y
   depends on RZV_IPC_CR8_CR8
   ---help---
     The initiator zeros the SHM ring headers on first open.  Only one
     side must be initiator; the other must be responder.
     CR8_0 = initiator (y), CR8_1 = responder (n).

config RZV_IPC_CR8_CR8_LOOPBACK
   bool "CR8_0 self-loopback test on /dev/ipccLB (no CR8_1 needed)"
   default n
   depends on RZV_IPC_CR8_CR8
   ---help---
     Wire MHU channel 16 TX back to channel 16 RX on CR8_0 alone.
     Registers /dev/ipccLB.  Used to smoke-test the ring driver before
     CR8_1 firmware is available.

config RZV_IPC_CR8_CM33
   bool "Instantiate /dev/ipcc2 for CR8_0 ↔ CM33"
   default n
   depends on RZV_IPC_RAW
   ---help---
     Register a raw IPCC character device at /dev/ipcc2 using MHU
     channels 10/15 and DDR SHM at 0x43810000.  Send path times out
     after CONFIG_RZV_IPC_TX_TIMEOUT_MS when CM33 firmware is absent.

config RZV_IPC_CR8_1_CM33
   bool "Instantiate /dev/ipcc3 for CR8_1 <-> CM33 (ESC relay leg)"
   default n
   depends on RZV_IPC_RAW
   ---help---
     Register a raw IPCC character device at /dev/ipcc3 using MHU
     channels 21/22 and DDR SHM at 0x43820000 (32 KiB).  CR8_1 is the
     initiator; the CM33 firmware is the responder.  This is the ESC leg
     of the FMU->IO->ESC relay (the FMU<->IO leg is RZV_IPC_CR8_CR8).
     Send path times out after CONFIG_RZV_IPC_TX_TIMEOUT_MS when CM33
     firmware is absent.

config RZV_MPU
   bool "RZ/V2H CR8 MPU region table"
   default y if RZV_IPC_RAW
   depends on !RZV2H_BUILD_CM33
   ---help---
     Programme the Cortex-R8 MPU with the canonical Renesas region
     table.  11 active regions per core covering ITCM, DTCM,
     SRAM, peripheral, xSPI, DDR cacheable/non-cacheable, OpenAMP RSCTBL,
     MHU SHMEM, and the 16 MiB VRING carveout (which also covers the IPC
     raw SHM at 0x43800000).  No IPC-specific MPU region is needed.
     Software cache ops in rzv_ipc_raw.c are retained for defence-in-depth.

config RZV_MPU_CR8_CORE_NUM
   int "CR8 core number for MPU table selection (0 or 1)"
   default 0
   range 0 1
   depends on RZV_MPU
   ---help---
     Selects which MPU region table variant to use.  0 = CR8_0 addresses,
     1 = CR8_1 addresses (SRAM cache/non-cache regions differ).

