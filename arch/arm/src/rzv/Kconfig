menuconfig RZV_ETHERNET
   bool "Ethernet (GBETH) Driver"
   default n
   depends on RZV_HAVE_ETHERC_MII || RZV_HAVE_ETHERC_RMII
   select NETDEVICES
   select ARCH_HAVE_NETDEV_STATISTICS
   ---help---
     Enable support for the RZV2H Gigabit Ethernet (GBETH) driver.
     The RZV2H has two Ethernet ports (GBETH0, GBETH1) using a
     DesignWare MAC (DWMAC) compatible architecture.

if RZV_ETHERNET

config RZV_ETHER0
   bool "Enable Ethernet Port 0 (GBETH0)"
   default y
   ---help---
     Enable Ethernet port 0 (GBETH0) at base address 0x15C30000.

config RZV_ETHER1
   bool "Enable Ethernet Port 1 (GBETH1)"
   default n
   ---help---
     Enable Ethernet port 1 (GBETH1) at base address 0x15C40000.

config RZV_ETHER_TXDESC
   int "Number of TX Descriptors"
   default 8
   range 4 64
   ---help---
     Number of TX DMA descriptors in the ring buffer.
     More descriptors allow higher throughput but use more memory.

config RZV_ETHER_RXDESC
   int "Number of RX Descriptors"
   default 8
   range 4 64
   ---help---
     Number of RX DMA descriptors in the ring buffer.
     More descriptors allow higher throughput but use more memory.

config RZV_ETHER_BUFSIZE
   int "Ethernet Buffer Size"
   default 1536
   ---help---
     Size of each TX/RX buffer. Should be at least MTU + headers + FCS.

config RZV_ETHER_PHY_ADDR
   int "PHY Address"
   default 0
   range 0 31
   ---help---
     MDIO address of the PHY connected to the Ethernet port.

config RZV_ETHER_PHY_RGMII
   bool "Use RGMII PHY Interface"
   default y
   ---help---
     Select RGMII (Reduced Gigabit MII) PHY interface.
     If not selected, MII or RMII will be used based on board configuration.

endif # RZV_ETHERNET

# Watchdog Timer (WDT)

config RZV_WDT
   bool "Watchdog Timer (WDT)"
   default n
   depends on RZV_HAVE_WDT
   select WATCHDOG
   ---help---
     Enable Watchdog Timer support. The RZV2H has 4 WDT channels, one for
     each CPU domain (CR8_0, CR8_1, CM33, CA55).

if RZV_WDT

config RZV_WDT_INTERRUPT_MODE
   bool "Use interrupt mode (NMI) instead of reset"
   default n
   ---help---
     Configure WDT to generate NMI interrupt on timeout instead of
     system reset. This allows for graceful handling of watchdog events.
     If not selected, the watchdog will cause a system reset on timeout.

config RZV_WDT0
   bool "WDT0 (CR8_0 domain)"
   default n
   ---help---
     Enable WDT0 for CR8_0 core domain. This is typically used for
     real-time control applications.

config RZV_WDT0_DEVPATH
   string "WDT0 device path"
   default "/dev/watchdog0"
   depends on RZV_WDT0
   ---help---
     Device path for WDT0, defaults to /dev/watchdog0

config RZV_WDT1
   bool "WDT1 (CR8_1 domain)"
   default n
   ---help---
     Enable WDT1 for CR8_1 core domain.

config RZV_WDT1_DEVPATH
   string "WDT1 device path"
   default "/dev/watchdog1"
   depends on RZV_WDT1
   ---help---
     Device path for WDT1, defaults to /dev/watchdog1

config RZV_WDT2
   bool "WDT2 (CM33 domain)"
   default n
   ---help---
     Enable WDT2 for CM33 core domain.

config RZV_WDT2_DEVPATH
   string "WDT2 device path"
   default "/dev/watchdog2"
   depends on RZV_WDT2
   ---help---
     Device path for WDT2, defaults to /dev/watchdog2

config RZV_WDT3
   bool "WDT3 (CA55 domain)"
   default n
   ---help---
     Enable WDT3 for CA55 core domain.

config RZV_WDT3_DEVPATH
   string "WDT3 device path"
   default "/dev/watchdog3"
   depends on RZV_WDT3
   ---help---
     Device path for WDT3, defaults to /dev/watchdog3

endif # RZV_WDT
