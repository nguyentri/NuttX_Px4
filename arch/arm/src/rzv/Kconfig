# RZV peripheral drivers

comment "RZV Peripheral Selection"

# Serial Communication Interface (SCI) - UART mode

config RZV_UART_SCI
   bool
   default n

config RZV_SCI0
   bool "SCI0 UART"
   default n
   select RZV_UART_SCI
   select SCI0_SERIALDRIVER
   ---help---
     Enable SCI0 in UART mode.

config RZV_SCI1
   bool "SCI1 UART"
   default n
   select RZV_UART_SCI
   select SCI1_SERIALDRIVER
   ---help---
     Enable SCI1 in UART mode.

