config RZV_GTM7_TIMER
   bool "GTM7 Timer"
   default n
   depends on RZV_HAVE_GTM7 && RZV_GTM && !RZV_HRT
   ---help---
     Enable GTM7 as a timer device.
     Cannot be enabled together with RZV_HRT (GTM7 channel conflict).

config RZV_HRT
   bool "PX4 High-Resolution Timer (HRT) via GTM7"
   default n
   depends on RZV_HAVE_GTM7 && !RZV_GTM7_TIMER
   ---help---
     Enable the PX4 HRT shim backed by GTM7 in free-running mode.
     GTM7 is reserved exclusively for HRT; do not enable RZV_GTM7_TIMER
     at the same time (channel conflict).  P1CLK (100 MHz) gives 10 ns
     resolution and ~42.9 s monotonic range per overflow epoch.

