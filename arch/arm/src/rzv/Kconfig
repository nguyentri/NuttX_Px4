# Watchdog Timer (WDT)

# CAN-FD Driver

menuconfig RZV_CANFD
   bool "CAN-FD driver (RSCAN-FD)"
   default n
   depends on RZV_HAVE_CAN0 || RZV_HAVE_CAN1
   select CAN
   select CAN_FD
   ---help---
     Enable the RZ/V2H CAN-FD lower-half driver.  The hardware block
     (RSCAN-FD) supports 6 channels at base 0x12440000.  v1 enables CH0
     (/dev/can0) only; CH1 framework is compiled but not registered.

     CANFDCLK = 80 MHz (verified by bsp_clock_cfg.h).
     Nominal timing: BRP=2, TSEG1=74, TSEG2=25, SJW=25 → 400 kbps.
     Data timing:    BRP=1, TSEG1=16, TSEG2=8,  SJW=8  → 3.2 Mbps.

     Boot default: internal loopback.  Toggle bus mode via ioctl cmd
     0x1000 with arg=0.

     Requires CONFIG_CAN_FD=y for 64-byte payload support.

if RZV_CANFD

config RZV_CANFD0
   bool "Enable CAN-FD channel 0 (/dev/can0)"
   default y
   depends on RZV_HAVE_CAN0
   ---help---
     Register CAN-FD channel 0 as /dev/can0.
     RDK-RZV2H: CAN1 connector (P80/P81, PSEL=5).
     CH0 is the primary channel for v1 bring-up.

config RZV_CANFD1
   bool "Enable CAN-FD channel 1 (/dev/can1)"
   default n
   depends on RZV_HAVE_CAN1
   ---help---
     Register CAN-FD channel 1 as /dev/can1.
     RDK-RZV2H: CAN2 connector (P86/P87, PSEL=5).
     Disabled by default at v1; enable after CH0 hardware validation.

config RZV_CANFD_IRQ_PRIORITY
   int "CAN-FD interrupt priority"
   default 12
   range 0 15
   ---help---
     GIC priority for all CAN-FD interrupts (TX, RX, error, global error).
     Lower number = higher priority.  12 matches other peripheral drivers
     in this BSP.

endif # RZV_CANFD

config ARCH_HAVE_SDIO
   bool
   default y if RZV_SDHI

config RZV_SDHI
   bool "SDHI (SD/eMMC) driver"
   default n
   select MMCSD
   select MMCSD_SDIO
   ---help---
     Enable the RZ/V2H SDHI lower-half driver.
     Supports SD0/SD1/SD2 channels on R9A09G057H.
     RDK-RZV2H SD card connector uses SD0 (signals QSD0_*).
     Phase 1: stub only (no hardware access).
     Phase 2 will implement PIO data path.

config RZV_WDT
   bool "Watchdog Timer (WDT)"
   default n
   depends on RZV_HAVE_WDT
   select WATCHDOG
   ---help---
     Enable Watchdog Timer support. The RZV2H has 4 WDT channels, one for
     each CPU domain (CR8_0, CR8_1, CM33, CA55).

if RZV_WDT

config RZV_WDT_INTERRUPT_MODE
   bool "Use interrupt mode (NMI) instead of reset"
   default n
   ---help---
     Configure WDT to generate NMI interrupt on timeout instead of
     system reset. This allows for graceful handling of watchdog events.
     If not selected, the watchdog will cause a system reset on timeout.

config RZV_WDT0
   bool "WDT0 (CR8_0 domain)"
   default n
   ---help---
     Enable WDT0 for CR8_0 core domain. This is typically used for
     real-time control applications.

config RZV_WDT0_DEVPATH
   string "WDT0 device path"
   default "/dev/watchdog0"
   depends on RZV_WDT0
   ---help---
     Device path for WDT0, defaults to /dev/watchdog0

config RZV_WDT1
   bool "WDT1 (CR8_1 domain)"
   default n
   ---help---
     Enable WDT1 for CR8_1 core domain.

config RZV_WDT1_DEVPATH
   string "WDT1 device path"
   default "/dev/watchdog1"
   depends on RZV_WDT1
   ---help---
     Device path for WDT1, defaults to /dev/watchdog1

config RZV_WDT2
   bool "WDT2 (CM33 domain)"
   default n
   ---help---
     Enable WDT2 for CM33 core domain.

config RZV_WDT2_DEVPATH
   string "WDT2 device path"
   default "/dev/watchdog2"
   depends on RZV_WDT2
   ---help---
     Device path for WDT2, defaults to /dev/watchdog2

